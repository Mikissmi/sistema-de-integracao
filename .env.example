# Copie para .env (uso local) ou configure como variáveis de ambiente no projeto da Vercel.
# O .env local é carregado automaticamente pela aplicação (python-dotenv) — não
# precisa exportar as variáveis manualmente no terminal.

SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Produção (Postgres/Neon, gerado automaticamente ao conectar o banco na aba Storage da Vercel):
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Obrigatória em produção (DEBUG=False) — sem ela a aplicação recusa subir.
# Em desenvolvimento (DEBUG=True) pode ficar em branco: uma chave temporária é
# gerada a cada start (os dados cifrados não sobrevivem a um restart local).
# NUNCA copie um valor de exemplo daqui para produção — gere uma chave própria com:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

DIAS_ALERTA_AGUARDANDO=10
DIAS_CRITICO_AGUARDANDO=15
DIAS_CRITICO_SEM_EVOLUCAO=30

# HSTS em produção: começa em 3600 (1h); depois de confirmar HTTPS estável,
# suba gradualmente até 31536000 (1 ano) — ver comentário em config/settings.py.
# SECURE_HSTS_SECONDS=3600

# E-mail (recuperação/troca de senha). Obrigatório em produção (DEBUG=False).
# Sem EMAIL_HOST em desenvolvimento, os e-mails só aparecem no console — não
# precisa preencher isso para testar localmente.
# Funciona com qualquer provedor SMTP (exemplos):
#   Gmail/Google Workspace: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587
#                            (use uma "senha de app", não a senha normal da conta)
#   SendGrid:  EMAIL_HOST=smtp.sendgrid.net, EMAIL_HOST_USER=apikey
#   Resend:    EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend
#   AWS SES:   EMAIL_HOST=email-smtp.<região>.amazonaws.com
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario@exemplo.com
# EMAIL_HOST_PASSWORD=senha-ou-api-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Acompanhamento Escola-Saúde <nao-responda@exemplo.com>

# Prazo (segundos) de validade do link de redefinição de senha. Padrão: 24h.
# PASSWORD_RESET_TIMEOUT=86400

# Dias de retenção do log de auditoria antes de ser apagado. Padrão: 365.
# RETENCAO_LOG_AUDITORIA_DIAS=365

# Segredo que autoriza a Vercel Cron a chamar /tasks/limpar-log-auditoria/.
# Gere um valor aleatório e configure-o também nas variáveis de ambiente do
# projeto na Vercel — sem isso, a limpeza agendada do log fica desativada.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=
